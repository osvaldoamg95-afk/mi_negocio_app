<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- SELECTOR DE MODO -->
    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/toggleGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:singleSelection="true"
        app:selectionRequired="true"
        app:checkedButton="@id/btnModeMonth">

        <Button
            android:id="@+id/btnModeDay"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="DÍA"/>

        <Button
            android:id="@+id/btnModeMonth"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="MES"/>

        <Button
            android:id="@+id/btnModeYear"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="AÑO"/>
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <!-- NAVEGADOR DE FECHA -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/btnPrev"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_media_previous"
            android:background="?attr/selectableItemBackgroundBorderless"/>

        <TextView
            android:id="@+id/txtCurrentPeriod"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="ENERO 2024"
            android:gravity="center"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#333"/>

        <ImageButton
            android:id="@+id/btnNext"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_media_next"
            android:background="?attr/selectableItemBackgroundBorderless"/>
    </LinearLayout>

    <!-- TARJETA DE RESULTADOS -->
    <androidx.cardview.widget.CardView
        android:layout_margin="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp">

        <LinearLayout
            android:padding="24dp"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- VENTAS -->
            <LinearLayout
                android:orientation="horizontal"
                android:layout_marginBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView android:text="VENTAS TOTALES" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/>
                <TextView android:id="@+id/txtSales" android:text="$ 0.00" android:textStyle="bold" android:textColor="#1976D2" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>

            <!-- COSTO -->
            <LinearLayout
                android:orientation="horizontal"
                android:layout_marginBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView android:text="COSTO MERCANCÍA" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/>
                <TextView android:id="@+id/txtCost" android:text="$ 0.00" android:textColor="#666" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>

            <View android:background="#DDD" android:layout_height="1dp" android:layout_width="match_parent" android:layout_marginTop="8dp" android:layout_marginBottom="8dp"/>

            <!-- GANANCIA BRUTA -->
            <LinearLayout
                android:orientation="horizontal"
                android:layout_marginBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView android:text="GANANCIA BRUTA" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/>
                <TextView android:id="@+id/txtGross" android:text="$ 0.00" android:textStyle="bold" android:textColor="#388E3C" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>

            <!-- GASTOS -->
            <LinearLayout
                android:orientation="horizontal"
                android:layout_marginBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView android:text="GASTOS OPERATIVOS" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/>
                <TextView android:id="@+id/txtExpenses" android:text="$ 0.00" android:textColor="#D32F2F" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>

            <View android:background="#333" android:layout_height="2dp" android:layout_marginTop="8dp" android:layout_marginBottom="8dp" android:layout_width="match_parent"/>

            <!-- UTILIDAD NETA -->
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView android:text="UTILIDAD NETA" android:textSize="18sp" android:textStyle="bold" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/>
                <TextView android:id="@+id/txtNet" android:text="$ 0.00" android:textSize="20sp" android:textStyle="bold" android:textColor="#000000" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- BOTÓN EXPORTAR -->
    <Button
        android:id="@+id/btnExport"
        android:text="EXPORTAR REPORTE (EXCEL)"
        android:backgroundTint="#4CAF50"
        android:layout_margin="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

</LinearLayout>
