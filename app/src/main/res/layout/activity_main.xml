<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- ENCABEZADO -->
        <TextView
            android:text="Mi Negocio 🚀"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="20dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <!-- TARJETAS DE RESUMEN (DASHBOARD) -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp">

            <!-- VENTA HOY -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="100dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                android:layout_marginEnd="8dp">

                <LinearLayout
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="10dp"
                    android:background="#E3F2FD"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <TextView
                        android:text="VENTAS HOY"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#1565C0"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/txtTodaySales"
                        android:text="$ 0.00"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#0D47A1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- GANANCIA HOY -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="100dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                android:layout_marginStart="8dp">

                <LinearLayout
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="10dp"
                    android:background="#E8F5E9"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <TextView
                        android:text="GANANCIA HOY"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#2E7D32"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/txtTodayProfit"
                        android:text="$ 0.00"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#1B5E20"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- ALERTA STOCK -->
        <TextView
            android:id="@+id/txtAlertStock"
            android:text="✅ Inventario saludable"
            android:textColor="#2E7D32"
            android:textStyle="bold"
            android:padding="8dp"
            android:layout_marginBottom="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- MENÚ DE ACCIONES (GRID 2 COLUMNAS) -->
        <GridLayout
            android:columnCount="2"
            android:rowCount="4"
            android:alignmentMode="alignMargins"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- VENTAS -->
            <Button
                android:id="@+id/btnVentas"
                android:text="🛒\nNUEVA VENTA"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:textSize="14sp"/>

            <!-- INVENTARIO -->
            <Button
                android:id="@+id/btnInventario"
                android:text="📦\nINVENTARIO"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:textSize="14sp"/>

            <!-- COMPRAS -->
            <Button
                android:id="@+id/btnOpenPurchase"
                android:text="🚚\nCOMPRAS"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:textSize="14sp"/>

            <!-- GASTOS -->
            <Button
                android:id="@+id/btnGastos"
                android:text="💸\nGASTOS"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:textSize="14sp"/>

            <!-- REPORTES -->
            <Button
                android:id="@+id/btnReportes"
                android:text="📊\nREPORTES"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:textSize="14sp"/>

            <!-- CIERRE -->
            <Button
                android:id="@+id/btnCloseDay"
                android:text="🔒\nCIERRE DIARIO"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:textSize="14sp"/>

            <!-- MANUFACTURA -->
            <Button
                android:id="@+id/btnRecetas"
                android:text="🍔\nRECETAS"
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:textSize="12sp"/>

            <!-- MATERIAS PRIMAS -->
            <Button
                android:id="@+id/btnMaterias"
                android:text="🌾\nMAT. PRIMAS"
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:textSize="12sp"/>

            <!-- HERRAMIENTAS (BACKUP/EXPORT) -->
            <Button
                android:id="@+id/btnTools"
                android:text="🛠\nHERRAMIENTAS"
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:textSize="12sp"/>

        </GridLayout>

    </LinearLayout>
</ScrollView>
